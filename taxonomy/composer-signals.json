  "platformRules": {
    "web": {
      "patterns": ["responsive-navigation"],
      "require": [
        "Preserve visible keyboard focus and complete keyboard access for interactive controls.",
        "Keep core tasks usable without hover-only interaction."
      ]
    },
    "responsive-web": {
      "patterns": ["responsive-navigation"],
      "require": [
        "Design for small through large viewports without removing core tasks at narrow widths.",
        "Preserve visible keyboard focus and complete keyboard access for interactive controls."
      ]
    },
    "mobile": {
      "patterns": ["responsive-navigation"],
      "require": [
        "Use touch-friendly targets and spacing for primary interactive controls.",
        "Do not require hover or pointer precision to complete a core task."
      ]
    },
    "desktop": {
      "patterns": ["primary-navigation"],
      "require": [
        "Preserve keyboard access and visible focus for recurring commands and navigation.",
        "Use available screen space for clarity and task efficiency rather than decorative surface multiplication."
      ]
    },
    "cross-platform": {
      "patterns": ["primary-navigation", "responsive-navigation"],
      "require": [
        "Preserve the same task hierarchy across platforms while adapting interaction mechanics to each input mode.",
        "Do not make a core workflow depend on hover, pointer precision, or a single viewport size."
      ]
    }
  },
