{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designdistillation.dev/schemas/recipe-blend.schema.json",
  "title": "Design Distillation Recipe Blend Request",
  "type": "object",
  "required": ["version", "selections", "rationale"],
  "properties": {
    "version": { "type": "string" },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "weight", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "role": { "enum": ["base", "influence"] }
        },
        "additionalProperties": false
      }
    },
    "rationale": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
