{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designdistillation.dev/schemas/audit-exceptions.schema.json",
  "title": "Design Distillation Audit Exceptions",
  "type": "object",
  "required": [
    "version",
    "exceptions"
  ],
  "properties": {
    "version": {
      "const": "0.7.0"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "reason"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
