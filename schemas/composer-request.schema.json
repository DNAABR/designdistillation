{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designdistillation.dev/schemas/composer-request.schema.json",
  "title": "Design Distillation Composer Request",
  "type": "object",
  "required": ["version", "product"],
  "properties": {
    "version": { "type": "string" },
    "product": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "platform": { "type": "string" },
        "audience": { "type": "string" },
        "primaryTask": { "type": "string" },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "properties": {
        "recipe": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "influences": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "weight"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 0.5
              }
            },
            "additionalProperties": false
          }
        },
        "personality": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "theme": {
          "enum": ["light", "dark", "high-contrast", "auto"]
        },
        "accessibilityTarget": {
          "type": "string",
          "minLength": 1
        },
        "reducedMotion": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
