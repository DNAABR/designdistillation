{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designdistillation.dev/schemas/registry-entry.schema.json",
  "title": "Design Distillation Registry Entry",
  "type": "object",
  "required": [
    "id",
    "version",
    "kind",
    "title",
    "summary",
    "platforms",
    "intent",
    "states",
    "slots",
    "variants",
    "token_refs",
    "patterns",
    "accessibility",
    "implementation",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "const": "0.6.0"
    },
    "kind": {
      "enum": [
        "component",
        "composition"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "use_when",
        "avoid_when"
      ],
      "properties": {
        "use_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "avoid_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "token_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "patterns": {
      "type": "object",
      "required": [
        "required",
        "related"
      ],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "implementation": {
      "type": "object",
      "required": [
        "source_owned",
        "adapters"
      ],
      "properties": {
        "source_owned": {
          "const": true
        },
        "adapters": {
          "type": "object",
          "required": [
            "css",
            "react"
          ],
          "properties": {
            "css": {
              "type": "object",
              "required": [
                "selectors"
              ],
              "properties": {
                "selectors": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "react": {
              "type": "object",
              "required": [
                "source",
                "exports"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "exports": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "origin",
        "redistribution"
      ],
      "properties": {
        "origin": {
          "const": "design-distillation"
        },
        "redistribution": {
          "const": "pending-repository-license"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
