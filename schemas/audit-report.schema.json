{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designdistillation.dev/schemas/audit-report.schema.json",
  "title": "Design Distillation Audit Report",
  "type": "object",
  "required": [
    "version",
    "profile",
    "scannedFiles",
    "summary",
    "findings"
  ],
  "properties": {
    "version": {
      "const": "0.7.0"
    },
    "profile": {
      "type": "object",
      "required": [
        "product",
        "baseRecipe"
      ],
      "properties": {
        "product": {
          "type": "string"
        },
        "baseRecipe": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scannedFiles": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "required": [
        "error",
        "warning",
        "style-deviation",
        "intentional-exception",
        "total"
      ],
      "properties": {
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "style-deviation": {
          "type": "integer",
          "minimum": 0
        },
        "intentional-exception": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "category",
          "file",
          "line",
          "message",
          "evidence"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "category": {
            "enum": [
              "error",
              "warning",
              "style-deviation",
              "intentional-exception"
            ]
          },
          "originalCategory": {
            "enum": [
              "error",
              "warning",
              "style-deviation"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "exceptionReason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
