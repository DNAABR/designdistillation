{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designdistillation.dev/schemas/corpus-entry.schema.json",
  "title": "Design Distillation Corpus Entry",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "summary",
    "problem",
    "use_when",
    "avoid_when",
    "rationale",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "problem": {
      "type": "string",
      "minLength": 20
    },
    "use_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "avoid_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "type": "string"
    },
    "implementation": {
      "type": "object"
    },
    "audit": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "title",
          "redistribution"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "redistribution": {
            "type": "object",
            "required": [
              "code",
              "assets"
            ],
            "properties": {
              "code": {
                "type": "boolean"
              },
              "assets": {
                "type": "boolean"
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "family": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "use_if": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prefer_alternatives_if": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keyboard": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semantics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "screen_reader": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "touch": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reduced_motion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "related": {
      "type": "object",
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anti_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
