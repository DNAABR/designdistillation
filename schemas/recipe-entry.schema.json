{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designdistillation.dev/schemas/recipe-entry.schema.json",
  "title": "Design Distillation Design Recipe",
  "allOf": [
    {
      "$ref": "./corpus-entry.schema.json"
    },
    {
      "type": "object",
      "required": [
        "category",
        "intent",
        "design_dna",
        "foundations",
        "patterns",
        "content",
        "constraints",
        "composition",
        "brand_safety"
      ],
      "properties": {
        "kind": { "const": "recipe" },
        "category": { "type": "string" },
        "intent": {
          "type": "object",
          "required": ["primary_outcomes", "interaction_model", "trust_level"],
          "properties": {
            "primary_outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "interaction_model": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "trust_level": { "enum": ["standard", "elevated", "high"] }
          }
        },
        "design_dna": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["target", "min", "max", "weight"],
            "properties": {
              "target": { "type": "integer", "minimum": 0, "maximum": 100 },
              "min": { "type": "integer", "minimum": 0, "maximum": 100 },
              "max": { "type": "integer", "minimum": 0, "maximum": 100 },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "foundations": {
          "type": "object",
          "required": ["layout", "typography", "color", "shape", "elevation", "motion", "iconography", "imagery"],
          "additionalProperties": { "type": "string" }
        },
        "patterns": {
          "type": "object",
          "required": ["prioritize", "consider", "avoid"],
          "properties": {
            "prioritize": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "consider": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "avoid": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "object",
          "required": ["voice", "density", "guidance"],
          "properties": {
            "voice": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "density": { "enum": ["low", "medium", "medium-high", "high"] },
            "guidance": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "constraints": {
          "type": "object",
          "required": ["hard", "strong_defaults", "exceptions"],
          "properties": {
            "hard": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "strong_defaults": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "exceptions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "composition": {
          "type": "object",
          "required": ["base_weight_min", "influence_weight_max", "protected_dimensions"],
          "properties": {
            "base_weight_min": { "type": "number", "minimum": 0.5, "maximum": 1 },
            "influence_weight_max": { "type": "number", "minimum": 0, "maximum": 0.5 },
            "protected_dimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "brand_safety": {
          "type": "object",
          "required": ["copy_brand_assets", "copy_proprietary_code", "imitate_named_product"],
          "properties": {
            "copy_brand_assets": { "const": false },
            "copy_proprietary_code": { "const": false },
            "imitate_named_product": { "const": false }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
