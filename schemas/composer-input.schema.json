{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designdistillation.dev/schemas/composer-input.schema.json",
  "title": "Design Distillation Composer Input",
  "type": "object",
  "required": [
    "version",
    "product"
  ],
  "properties": {
    "version": {
      "const": "0.5.0"
    },
    "product": {
      "type": "object",
      "required": [
        "name",
        "type",
        "description",
        "platform",
        "audience",
        "primary_task"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "platform": {
          "enum": [
            "web",
            "responsive-web",
            "mobile",
            "desktop",
            "cross-platform"
          ]
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "primary_task": {
          "type": "string",
          "minLength": 1
        },
        "category_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "descriptors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prominence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "personality": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "reduced_motion": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "properties": {
        "theme": {
          "enum": [
            "light",
            "dark",
            "high-contrast"
          ]
        },
        "require": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid_anti_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "recipe_selection": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "explicit"
          ]
        },
        "selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "weight"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "inspiration": {
      "type": "object",
      "properties": {
        "traits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "named_products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
