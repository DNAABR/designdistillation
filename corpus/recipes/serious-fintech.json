    "guidance": [
      "State amounts, status, and consequences explicitly.",
      "Prefer concrete verbs over reassuring marketing language."
    ]
  },
  "constraints": {
    "hard": [
      "Never hide consequential transaction state in transient feedback.",
      "Never trade numeric legibility or accessible contrast for brand styling."
    ],
    "strong_defaults": [
      "Require review for consequential submissions.",
      "Use tabular numerals where financial comparison benefits.",
      "Keep motion subtle and functional."
    ],
    "exceptions": [
      "Higher brand expression is acceptable in non-transactional marketing or education surfaces."
    ]
  },
