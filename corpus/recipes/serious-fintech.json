{
  "id": "serious-fintech",
  "kind": "recipe",
  "title": "Serious Fintech",
  "summary": "A high-trust financial recipe emphasizing legibility, explicit transaction state, restrained decoration, and confident review/recovery flows.",
  "problem": "Financial interfaces become risky when visual novelty competes with amounts, account state, transaction consequences, or recovery information.",
  "use_when": [
    "Products handling money, balances, financial decisions, or consequential transactions",
    "Trust and error prevention matter more than visual novelty"
  ],
  "avoid_when": [
    "Purely educational finance content with no account or transaction state",
    "Play-first experiences where financial data is incidental"
  ],
  "rationale": [
    "Financial consequences require explicit state and confirmation.",
    "Stable hierarchy and restrained motion support trust.",
    "Numbers and status need stronger visual priority than branding."
  ],
  "tags": [
    "fintech",
    "design-recipe"
  ],
