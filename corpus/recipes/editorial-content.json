{
  "id": "editorial-content",
  "kind": "recipe",
  "title": "Editorial Content",
  "summary": "A typography-led content recipe for reading, publishing, cultural, and knowledge experiences where hierarchy, rhythm, and text quality dominate chrome.",
  "problem": "Editorial experiences lose character and readability when application-style cards, controls, and equal-weight sections overwhelm the content.",
  "use_when": [
    "Long-form publishing, magazines, essays, cultural archives, or knowledge-heavy reading",
    "Typography and content hierarchy are the primary experience"
  ],
  "avoid_when": [
    "Dense operational tools with frequent state-changing actions",
    "Interfaces where rapid data manipulation matters more than reading"
  ],
  "rationale": [
    "Typography can carry hierarchy without many surfaces.",
    "Whitespace and measure improve reading rhythm.",
    "Restrained motion and iconography preserve content focus."
  ],
