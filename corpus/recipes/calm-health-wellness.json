    "voice": [
      "calm",
      "supportive",
      "specific"
    ],
    "density": "medium",
    "guidance": [
      "Avoid shame, urgency theater, or ambiguous reassurance.",
      "Explain status and next actions in plain language."
    ]
  },
  "constraints": {
    "hard": [
      "Health-relevant status must remain understandable without relying on color alone.",
      "Do not use gamification to obscure meaningful warnings or uncertainty."
    ],
    "strong_defaults": [
      "Use generous spacing and restrained motion.",
      "Make trends and progress explainable.",
      "Keep permissions contextual and recoverable."
    ],
    "exceptions": [
      "Fitness challenge or community areas may use higher energy while health-status surfaces stay calm."
    ]
  },
