{
  "id": "calm-health-wellness",
  "kind": "recipe",
  "title": "Calm Health and Wellness",
  "summary": "A calm, supportive recipe for personal health and wellness products emphasizing comprehension, reassurance, privacy-aware state, and low-pressure guidance.",
  "problem": "Health and wellness interfaces can become stressful when dense dashboards, alarmist color, playful gamification, or vague status language compete with comprehension.",
  "use_when": [
    "Wellness tracking, fitness guidance, health education, appointment-adjacent, or personal progress products",
    "Users benefit from calm explanation and visible progress"
  ],
  "avoid_when": [
    "Emergency or acute-care interfaces requiring stronger alert hierarchy",
    "Professional clinical systems needing much denser specialist information"
  ],
  "rationale": [
    "Calm hierarchy reduces unnecessary stress.",
    "Warmth can coexist with precise state and accessible contrast.",
    "Progress should be informative without moralizing or excessive gamification."
  ],
  "tags": [
    "health-wellness",
    "design-recipe"
  ],
