{
  "id": "creative-software",
  "kind": "recipe",
  "title": "Creative Software",
  "summary": "A professional creation-tool recipe balancing dense controls, canvas or asset focus, persistent state, and restrained chrome around expressive user work.",
  "problem": "Creative tools fail when the product UI competes visually with the content being created or hides expert controls behind consumer-style simplification.",
  "use_when": [
    "Design, media, authoring, editing, or asset-management tools",
    "Users spend long sessions manipulating content with repeated controls"
  ],
  "avoid_when": [
    "Simple one-shot creation flows for casual users",
    "Content-only viewing experiences"
  ],
  "rationale": [
    "The created artifact should dominate the workspace.",
    "Expert users benefit from persistent controls and compact density.",
    "System chrome needs neutrality even when the output itself is expressive."
  ],
  "tags": [
    "creative-software",
    "design-recipe"
  ],
