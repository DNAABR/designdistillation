  "content": {
    "voice": [
      "professional",
      "compact",
      "tool-oriented"
    ],
    "density": "high",
    "guidance": [
      "Prefer familiar domain terminology for expert controls.",
      "Keep destructive and save state explicit."
    ]
  },
  "constraints": {
    "hard": [
      "The user's created content must remain visually distinguishable from application chrome.",
      "Never claim work is saved before persistence completes."
    ],
    "strong_defaults": [
      "Keep expert controls persistent where repeated use justifies them.",
      "Use icons only when meanings are stable or labeled.",
      "Support undo for reversible editing actions."
    ],
    "exceptions": [
      "Beginner modes may lower density and reveal advanced controls progressively."
    ]
  },
