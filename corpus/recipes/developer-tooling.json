{
  "id": "developer-tooling",
  "kind": "recipe",
  "title": "Developer Tooling",
  "summary": "A dense, keyboard-friendly recipe for technical products where speed, state visibility, search, and complex information structures matter more than decorative presentation.",
  "problem": "Developer tools become inefficient when consumer-style spacing, hidden navigation, oversized cards, or decorative effects reduce information throughput.",
  "use_when": [
    "IDEs, API tools, infrastructure dashboards, developer platforms, or technical administration",
    "Users repeatedly search, inspect, edit, and compare structured information"
  ],
  "avoid_when": [
    "Beginner learning products where dense technical presentation increases cognitive load",
    "Visual consumer discovery experiences"
  ],
  "rationale": [
    "Technical work benefits from stable navigation and high information density.",
    "Keyboard and search paths reduce repeated interaction cost.",
    "Visual restraint leaves room for code, logs, state, and metadata."
  ],
  "tags": [
    "developer-tools",
    "design-recipe"
  ],
  "platforms": [
    "cross-platform"
  ],
  "stage": "foundation",
  "category": "developer-tools",
  "intent": {
    "primary_outcomes": [
      "fast technical navigation",
      "inspect system state",
      "edit structured information"
    ],
    "interaction_model": [
      "keyboard-heavy application shell",
      "search",
      "dense data views"
    ],
    "trust_level": "elevated"
  },
