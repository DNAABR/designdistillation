    "color": "technical-neutral",
    "shape": "compact",
    "elevation": "flat",
    "motion": "minimal",
    "iconography": "functional",
    "imagery": "none"
  },
  "patterns": {
    "prioritize": [
      "primary-navigation",
      "search-query-state",
      "filters-and-sort",
      "data-table-controls",
      "table-vs-grid",
      "save-status-feedback",
      "progressive-disclosure",
      "settings-by-user-goal"
    ],
    "consider": [
      "breadcrumbs-for-hierarchy",
      "tabs-for-peer-sections",
      "offline-resilience",
      "bulk-selection-actions",
      "pagination-vs-infinite-scroll"
    ],
    "avoid": [
      "card-everything",
      "hidden-primary-navigation",
      "modal-everything",
      "spinner-without-progress-context"
    ]
  },
  "content": {
    "voice": [
      "technical",
      "concise",
      "specific"
    ],
    "density": "high",
    "guidance": [
      "Prefer precise object and action names.",
      "Expose useful state and metadata without explanatory filler."
    ]
  },
  "constraints": {
    "hard": [
      "Do not hide frequently used technical state behind decorative layers.",
      "Preserve keyboard and focus efficiency for repeated workflows."
    ],
    "strong_defaults": [
      "Use compact spacing and stable navigation.",
      "Prefer text labels where icon meaning is ambiguous.",
      "Keep animation minimal."
    ],
    "exceptions": [
      "Onboarding and documentation surfaces can use lower density and more explanation."
    ]
  },
  "composition": {
    "base_weight_min": 0.6,
    "influence_weight_max": 0.3,
