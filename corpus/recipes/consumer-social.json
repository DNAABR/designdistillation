    "density": "medium",
    "guidance": [
      "Keep system messages distinct from user-generated content.",
      "Use playful copy sparingly around errors and safety-relevant state."
    ]
  },
  "constraints": {
    "hard": [
      "User content must remain more prominent than ornamental chrome.",
      "Critical state must remain legible despite expressive branding."
    ],
    "strong_defaults": [
      "Use motion for direct feedback and continuity.",
      "Favor responsive touch-first interaction.",
      "Use media as content rather than background decoration."
    ],
    "exceptions": [
      "Moderation, privacy, billing, and account-security flows should adopt a more restrained high-trust posture."
    ]
  },
