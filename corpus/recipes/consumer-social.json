{
  "id": "consumer-social",
  "kind": "recipe",
  "title": "Consumer Social",
  "summary": "An expressive but controlled consumer recipe for feed, community, and interpersonal products where identity, media, responsiveness, and fast feedback matter.",
  "problem": "Social products can become visually chaotic when every interaction competes for attention or when engagement patterns override clear state and user control.",
  "use_when": [
    "Community, messaging-adjacent, sharing, profile, or feed-led products",
    "Identity and content discovery are central to the experience"
  ],
  "avoid_when": [
    "High-trust transactional tools",
    "Dense professional workflows where expressive UI reduces throughput"
  ],
  "rationale": [
    "Content and people should remain the visual focus.",
    "Playfulness can support identity without making system state ambiguous.",
    "Responsive and permission flows are core rather than edge cases."
  ],
  "tags": [
    "consumer-social",
    "design-recipe"
  ],
