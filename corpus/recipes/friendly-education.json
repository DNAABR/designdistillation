{
  "id": "friendly-education",
  "kind": "recipe",
  "title": "Friendly Education",
  "summary": "A welcoming learning recipe that favors clear progression, supportive feedback, approachable color, and low-friction guidance without turning study into visual noise.",
  "problem": "Education products often oscillate between sterile enterprise UI and excessive gamification that competes with comprehension.",
  "use_when": [
    "Learning products for self-directed students or guided practice",
    "Progress and feedback should feel encouraging without obscuring content"
  ],
  "avoid_when": [
    "Expert tools where dense professional workflows dominate",
    "High-stakes assessment interfaces that require a more restrained posture"
  ],
  "rationale": [
    "Warmth and progression can reduce friction while content remains primary.",
    "Friendly hierarchy can coexist with rigorous feedback.",
    "Motion and illustration should support learning state, not distract from it."
  ],
  "tags": [
    "education",
    "design-recipe"
  ],
  "platforms": [
