{
  "id": "public-service",
  "kind": "recipe",
  "title": "Public Service",
  "summary": "A high-clarity service recipe for broad public audiences, prioritizing plain language, accessible forms, predictable navigation, robust recovery, and low decorative burden.",
  "problem": "Public-facing services become exclusionary when branding, jargon, complex layouts, or inaccessible interactions make essential tasks harder to complete.",
  "use_when": [
    "Government, civic, benefits, utility, or broadly accessible service transactions",
    "Users may have varied digital confidence, devices, abilities, and urgency"
  ],
  "avoid_when": [
    "Immersive entertainment, luxury storytelling, or highly expressive consumer discovery",
    "Specialist internal tools used only by trained professionals"
  ],
  "rationale": [
    "Service completion and comprehension outrank visual novelty.",
    "Broad audiences require resilient forms and predictable interaction.",
    "Accessibility must be treated as a baseline across the entire journey."
  ],
  "tags": [
    "public-service",
    "design-recipe"
  ],
  "platforms": [
    "cross-platform"
  ],
  "stage": "foundation",
  "category": "public-service",
  "intent": {
    "primary_outcomes": [
      "complete an essential service",
      "understand eligibility and consequences",
      "recover from errors"
    ],
    "interaction_model": [
      "task-led forms",
      "service navigation",
      "confirmation"
    ],
    "trust_level": "high"
  },
