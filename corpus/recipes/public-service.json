    "typography": "service-ui",
    "color": "service-high-clarity",
    "shape": "service-functional",
    "elevation": "flat",
    "motion": "minimal",
    "iconography": "sparse",
    "imagery": "sparse"
  },
  "patterns": {
    "prioritize": [
      "question-focused-forms",
      "labels-hints-and-optionality",
      "error-recovery",
      "preserve-form-input",
      "forgiving-input",
      "review-before-submit",
      "transaction-confirmation",
      "responsive-navigation"
    ],
    "consider": [
      "minimal-account-creation",
      "breadcrumbs-for-hierarchy",
      "progressive-disclosure"
    ],
    "avoid": [
      "placeholder-only-labels",
      "premature-validation",
      "toast-only-critical-feedback",
      "modal-everything",
      "spinner-without-progress-context",
      "hidden-primary-navigation"
    ]
  },
  "content": {
    "voice": [
      "plain",
      "direct",
      "non-promotional"
    ],
    "density": "medium",
    "guidance": [
      "Use words users understand rather than organisational terminology.",
      "Explain eligibility, cost, time, and next steps at the point they matter."
    ]
  },
  "constraints": {
    "hard": [
      "Accessibility and task completion outrank brand expression.",
      "Essential information must not depend on color, motion, hover, or transient feedback."
    ],
    "strong_defaults": [
      "Ask only necessary questions.",
      "Use simple page structures and explicit headings.",
      "Preserve valid answers through recovery."
    ],
    "exceptions": [
      "Campaign or informational landing pages may use more visual expression if service entry remains clear."
    ]
  },
  "composition": {
    "base_weight_min": 0.75,
    "influence_weight_max": 0.15,
    "protected_dimensions": [
      "contrast",
      "formality",
      "content-prominence",
      "accessibility",
      "transaction-clarity"
    ]
  },
