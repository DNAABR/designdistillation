{
  "id": "focused-saas",
  "kind": "recipe",
  "title": "Focused SaaS",
  "summary": "A restrained application recipe for task-oriented software that needs clarity, moderate-to-high information density, and low decorative overhead.",
  "problem": "Generic SaaS generation often mixes excessive cards, oversized marketing spacing, decorative gradients, and inconsistent density inside a product interface.",
  "use_when": [
    "Building productivity, operations, project, or business software",
    "The primary value comes from repeated task completion rather than visual discovery"
  ],
  "avoid_when": [
    "The core product is immersive entertainment or highly visual discovery",
    "The audience requires unusually low information density"
  ],
  "rationale": [
    "Restrained surfaces preserve attention for content and actions.",
    "Consistent compact spacing supports repeated workflows.",
    "Sparse accent usage keeps primary actions and state changes legible."
  ],
  "tags": [
    "saas",
    "design-recipe"
  ],
  "platforms": [
    "cross-platform"
  ],
  "stage": "foundation",
  "category": "saas",
  "intent": {
    "primary_outcomes": [
      "fast repeated task completion",
      "clear system state"
    ],
    "interaction_model": [
      "persistent application shell",
      "frequent forms and data views"
    ],
    "trust_level": "elevated"
  },
