  "patterns": {
    "prioritize": [
      "primary-navigation",
      "responsive-navigation",
      "loading-feedback",
      "empty-state-next-action",
      "error-recovery",
      "save-status-feedback",
      "settings-by-user-goal",
      "data-table-controls"
    ],
    "consider": [
      "search-query-state",
      "filters-and-sort",
      "pagination-vs-infinite-scroll",
      "progressive-disclosure"
    ],
    "avoid": [
      "card-everything",
      "spinner-without-progress-context",
      "modal-everything",
      "hidden-primary-navigation"
    ]
  },
  "content": {
    "voice": [
      "clear",
      "direct",
      "professional"
    ],
    "density": "medium-high",
    "guidance": [
      "Prefer action-oriented labels.",
      "Keep help contextual rather than promotional."
    ]
  },
  "constraints": {
    "hard": [
      "Preserve complete loading, empty, error, disabled, and focus behavior.",
      "Use semantic tokens rather than arbitrary component values."
    ],
    "strong_defaults": [
      "Use typography, spacing, and alignment before adding surfaces.",
      "Keep one dominant accent strategy.",
      "Prefer persistent navigation for recurring destinations."
    ],
    "exceptions": [
      "More expressive brand treatment is acceptable when it does not reduce task clarity."
    ]
  },
  "composition": {
    "base_weight_min": 0.6,
    "influence_weight_max": 0.3,
