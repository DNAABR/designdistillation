    "density": "medium",
    "guidance": [
      "Keep action labels conventional even when surrounding copy is playful.",
      "Reserve celebratory language for genuine progress or success."
    ]
  },
  "constraints": {
    "hard": [
      "Animation must respect reduced-motion preferences.",
      "Gameplay styling must not make ordinary controls ambiguous."
    ],
    "strong_defaults": [
