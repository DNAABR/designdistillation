{
  "id": "gaming-companion",
  "kind": "recipe",
  "title": "Gaming Companion",
  "summary": "A high-energy companion recipe for game-adjacent apps that can use expressive color, shape, and motion while keeping controls, progression, and state functional.",
  "problem": "Game-adjacent interfaces often mistake visual intensity for usability, producing unreadable HUD-like screens, constant animation, and decorative controls.",
  "use_when": [
    "Companion apps, party-game utilities, game communities, progression trackers, or playful utility products",
    "Expressive identity is part of the value but the product still needs conventional task flows"
  ],
  "avoid_when": [
    "High-stakes financial, medical, or government transactions",
    "Long-form reading products"
  ],
  "rationale": [
    "Playful visual language can create identity when functional state stays clear.",
    "Motion is most effective when tied to feedback, progression, or continuity.",
    "Conventional navigation prevents expressive UI from becoming confusing."
  ],
  "tags": [
    "gaming-companion",
    "design-recipe"
  ],
